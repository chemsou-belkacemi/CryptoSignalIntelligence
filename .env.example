# Surcharges facultatives de config/default.toml (préfixe CSI_, sections séparées par __).
# Aucune clé Binance n'est nécessaire ni utilisée : ce projet n'exécute aucun ordre.
# Ce fichier n'est PAS lu automatiquement : définir les variables dans la session PowerShell,
# par exemple  $env:CSI_DATA__SYMBOLS='["BTCUSDT","ETHUSDT"]'

# CSI_CONFIG_FILE=config/default.toml
# CSI_ROOT=C:\chemin\vers\CryptoSignalIntelligence
# CSI_DATA__SYMBOLS=["BTCUSDT","ETHUSDT"]
# CSI_DATA__HISTORY_START=2021-01-01
# CSI_PUBLICATION__MODE=shadow

# Lot 6 uniquement (agents) — jamais requis par le mode quantitatif :
# CSI_LLM_API_KEY=
