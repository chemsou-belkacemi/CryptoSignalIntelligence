{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(Get-Content .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)"
    ],
    "ask": [
      "Edit(**/research/protocol.py)",
      "Write(**/research/protocol.py)",
      "Edit(**/config/exit_policies.json)",
      "Write(**/config/exit_policies.json)",
      "Edit(**/backtest/exits.py)",
      "Write(**/backtest/exits.py)",
      "Edit(**/data/http.py)",
      "Write(**/data/http.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_on_edit.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
